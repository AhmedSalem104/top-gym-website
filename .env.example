# Local/review default: do not index preview builds.
# Production Vercel uses the confirmed public origin and PUBLIC_INDEXABLE=true.
# SITE_URL=https://top-gym-website.vercel.app
PUBLIC_INDEXABLE=false

# Challenge stays hidden until separate staging/production approvals.
PUBLIC_CHALLENGE_ENABLED=false
# Server-only gateway configuration; no SMTP/OTP/DB secrets in the browser.
CHALLENGE_BACKEND_URL=
CHALLENGE_GATEWAY_KEY=
CHALLENGE_ORIGIN=

# Server-only secrets. Configure directly in Vercel; never use PUBLIC_ prefixes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
FEEDBACK_RECIPIENT_EMAIL=
FEEDBACK_FROM_NAME=TOP GYM Website
FEEDBACK_ORIGIN=https://top-gym-website.vercel.app
# Add an Upstash Redis integration in Vercel and copy its REST configuration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate at least 32 random characters; used only for keyed privacy-safe hashes.
FEEDBACK_HASH_SECRET=
