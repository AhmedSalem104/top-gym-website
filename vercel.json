{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/challenge/v1/:__tg_path*/",
      "destination": "/api/challenge/?__tg_route=v1/:__tg_path*"
    }
  ],
  "functions": {
    "api/feedback.ts": { "maxDuration": 45 },
    "api/challenge.ts": { "maxDuration": 25 }
  }
}
