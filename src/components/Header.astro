---
import { business, publicCredentials, type Locale } from '../config/business';
import { t } from '../i18n';
import Icon from './Icon.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { feedbackCopy } from '../i18n/feedback';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const links = [
  'top',
  'about',
  'facilities',
  ...(publicCredentials.length ? ['credentials'] : []),
  'gallery',
  'memberships',
  'schedule',
  'location',
  'contact',
] as (keyof typeof copy)[];
---

<a class="skip-link" href="#main">
  {copy.skip}
</a>
<header class="site-header">
  <div class="header-inner" data-motion="hero" data-motion-group>
    <a class="brand" href="#top" aria-label="TOP GYM">
      <img src={business.logo} width="44" height="44" alt={copy.brandAlt} />
      <span>TOP GYM</span>
    </a>
    <nav class="desktop-nav" aria-label={copy.navLabel}>
      <span class="nav-spotlight" aria-hidden="true"></span>
      {links.map((id) => (
        <a data-section-link href={`#${id}`}>
          {copy[id]}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <LanguageSwitch locale={locale} />
      <a class="button button-dark header-call" href="#contact">
        <Icon name="phone" />
        {copy.callUs}
      </a>
      <a
        class="button button-gold header-group"
        href={business.links.whatsappGroup}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="chat" />
        {copy.group}
      </a>
      <button
        class="icon-button menu-toggle"
        aria-label={copy.menu}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label={copy.navLabel} hidden>
    <div class="mobile-language">
      <span>Language / اللغة</span>
      <LanguageSwitch locale={locale} />
    </div>
    {links.map((id) => (
      <a data-section-link href={`#${id}`}>
        {copy[id]}
      </a>
    ))}
    <div class="mobile-nav-actions">
      <a class="button button-dark" href="#feedback" data-section-link>
        {feedbackCopy[locale].link}
      </a>
      <a
        class="button button-gold"
        href={business.links.whatsappGroup}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="chat" />
        {copy.group}
      </a>
      <a class="button button-dark" href="#contact">
        <Icon name="phone" />
        {copy.callUs}
      </a>
    </div>
  </nav>
</header>
