---
import { type Locale, type Membership } from '../config/business';
import { durations, money, t } from '../i18n';
import Icon from './Icon.astro';
interface Props {
  locale: Locale;
  membership: Membership;
  featured?: boolean;
}
const { locale, membership, featured = false } = Astro.props;
const copy = t(locale);
---

<article class:list={['membership-card', { featured }]}>
  <span class="eyebrow">TOP GYM</span>
  <h3>{membership.name[locale]}</h3>
  <p>{membership.description[locale]}</p>
  <div class="price-block">
    <strong class="price" data-price={membership.id}>
      {money(membership.prices.month, locale)}
    </strong>
    <span>
      {copy.total} <span data-duration-label>{durations.month[locale]}</span>
    </span>
  </div>
  <a href="#contact" class:list={['button', featured ? 'button-gold' : 'button-dark']}>
    {copy.askMembership}
    <Icon name="arrow" />
  </a>
</article>
