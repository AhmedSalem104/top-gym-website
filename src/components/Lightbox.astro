---
import { t } from '../i18n';
import type { Locale } from '../config/business';
import Icon from './Icon.astro';
import '../styles/lightbox.css';
interface Props {
  locale: Locale;
}
const copy = t(Astro.props.locale);
---

<dialog class="lightbox" id="lightbox" aria-labelledby="lightbox-caption" data-of={copy.imageOf}>
  <div class="lightbox-toolbar">
    <span id="lightbox-count" aria-live="polite"></span>
    <div class="lightbox-tools">
      <button
        class="certificate-zoom"
        data-lightbox-zoom
        aria-controls="lightbox-stage"
        aria-pressed="false"
        hidden
      >
        <Icon name="expand" />
        <span>{copy.certificateZoomIn}</span>
      </button>
      <button class="icon-button" data-lightbox-close aria-label={copy.close} autofocus>
        <Icon name="close" />
      </button>
    </div>
  </div>
  <div class="lightbox-stage" id="lightbox-stage">
    <img id="lightbox-image" alt="" width="960" height="1280" />
  </div>
  <div class="lightbox-bottom">
    <button class="icon-button" data-lightbox-prev aria-label={copy.previous}>
      <span class="rotate">
        <Icon name="chevron" />
      </span>
    </button>
    <p id="lightbox-caption"></p>
    <button class="icon-button" data-lightbox-next aria-label={copy.next}>
      <Icon name="chevron" />
    </button>
  </div>
</dialog>
