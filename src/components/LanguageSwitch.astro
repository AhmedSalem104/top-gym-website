---
import type { Locale } from '../config/business';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="language-switch" dir="ltr" aria-label="Language / اللغة">
  {(['en', 'ar'] as const).map((language) =>
    language === locale ? (
      <span aria-current="true" lang={language}>
        {language === 'en' ? 'EN' : 'العربية'}
      </span>
    ) : (
      <a data-language-switch href={`/${language}/`} lang={language} hreflang={language}>
        {language === 'en' ? 'EN' : 'العربية'}
      </a>
    ),
  )}
</div>
