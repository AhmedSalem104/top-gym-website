---
import { business, publicCredentials, type Locale } from '../config/business';
import { t } from '../i18n';
import Icon from '../components/Icon.astro';
import '../styles/credentials.css';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const date = (value: string) =>
  new Intl.DateTimeFormat(locale === 'ar' ? 'ar-EG' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${value}T00:00:00Z`));
---

{publicCredentials.length > 0 && (
  <section id="credentials" class="section surface credentials" aria-labelledby="credentials-title">
    <div class="container">
      <div class="credentials-intro" data-motion-group>
        <p class="eyebrow" data-motion="heading">
          <Icon name="document" />
          {copy.credentialsLabel}
        </p>
        <h2 id="credentials-title" data-motion="heading">
          {copy.credentialsTitle} <em>{copy.credentialsHighlight}</em>
        </h2>
        <p class="section-description" data-motion="reveal">
          {copy.credentialsText}
        </p>
        <p class="credential-holder" data-motion="reveal">
          <span>{copy.certificateHolder}</span>
          <bdi>{business.trainer.name}</bdi>
        </p>
      </div>
      <div class="credential-grid" data-motion-group data-motion-step="2">
        {publicCredentials.map((credential) => (
          <article class="credential-card" data-motion="image">
            <a
              href={credential.image}
              data-lightbox="certificates"
              class="credential-preview"
              data-caption={`${credential.title[locale]} · ${credential.issuer} · ${copy.trainingPeriod}: ${date(credential.period.start)} – ${date(credential.period.end)}`}
              data-alt={credential.title[locale]}
            >
              <div class="credential-document">
                <img
                  src={credential.preview}
                  srcset={`${credential.image.replace('.webp', '-320.webp')} 320w, ${credential.preview} 680w, ${credential.image.replace('.webp', '-960.webp')} 960w`}
                  sizes="(min-width: 1440px) 366px, (min-width: 1101px) calc(31vw - 74px), (min-width: 768px) calc(46vw - 70px), calc(100vw - 98px)"
                  width={credential.width}
                  height={credential.height}
                  loading="lazy"
                  decoding="async"
                  alt={credential.title[locale]}
                />
              </div>
              <div class="credential-summary">
                <h3>{credential.title[locale]}</h3>
                <p class="credential-issuer">
                  <bdi>{credential.issuer}</bdi>
                </p>
                <dl class="credential-period">
                  <dt>{copy.trainingPeriod}</dt>
                  <dd>
                    <time datetime={credential.period.start}>{date(credential.period.start)}</time>
                    <span aria-hidden="true"> – </span>
                    <time datetime={credential.period.end}>{date(credential.period.end)}</time>
                  </dd>
                </dl>
              </div>
              <span class="credential-expand">
                <span class="credential-action-label">{copy.certificate}</span>
                <span class="credential-action-icon">
                  <Icon name="expand" />
                </span>
              </span>
            </a>
          </article>
        ))}
      </div>
      <p class="credential-privacy" data-motion="fade">
        {copy.certificatePrivacy}
      </p>
    </div>
  </section>
)}
