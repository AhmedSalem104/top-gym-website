---
import { business, publicCredentials, type Locale } from '../config/business';
import { t } from '../i18n';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const date = (value: string) =>
  new Intl.DateTimeFormat(locale === 'ar' ? 'ar-EG' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${value}T00:00:00Z`));
---

{publicCredentials.length > 0 && (
  <section id="credentials" class="section surface">
    <div class="container">
      <SectionHeading
        eyebrow={copy.credentialsLabel}
        title={copy.credentialsTitle}
        description={copy.credentialsText}
      />
      <p class="credential-holder" data-motion="reveal">
        {copy.certificateHolder} <bdi>{business.trainer.name}</bdi>
      </p>
      <div class="credential-grid" data-motion-group data-motion-step="2">
        {publicCredentials.map((credential) => (
          <article class="credential-card" data-motion="image">
            <a
              href={credential.image}
              data-lightbox="certificates"
              class="credential-preview"
              data-caption={`${credential.title[locale]} · ${credential.issuer} · ${copy.trainingPeriod}: ${date(credential.period.start)} – ${date(credential.period.end)}`}
              data-alt={credential.title[locale]}
              aria-label={`${copy.certificate}: ${credential.title[locale]}`}
            >
              <img
                src={credential.preview}
                width={credential.width}
                height={credential.height}
                loading="lazy"
                alt={credential.title[locale]}
              />
              <span class="credential-expand">
                <Icon name="expand" />
                {copy.certificate}
              </span>
            </a>
            <div class="card-content">
              <h3>{credential.title[locale]}</h3>
              <p>{credential.issuer}</p>
              <p class="credential-period">
                {copy.trainingPeriod}
                <br />
                <time datetime={credential.period.start}>{date(credential.period.start)}</time>
                <span aria-hidden="true"> – </span>
                <time datetime={credential.period.end}>{date(credential.period.end)}</time>
              </p>
            </div>
          </article>
        ))}
      </div>
      <p class="credential-privacy" data-motion="fade">
        {copy.certificatePrivacy}
      </p>
    </div>
  </section>
)}
