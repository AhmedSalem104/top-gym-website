---
import { publicCredentials, type Locale } from '../config/business';
import { t } from '../i18n';
import SectionHeading from '../components/SectionHeading.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

{publicCredentials.length > 0 && (
  <section id="credentials" class="section surface">
    <div class="container">
      <SectionHeading
        eyebrow={copy.credentialsLabel}
        title={copy.credentialsTitle}
        description={copy.credentialsText}
      />
      <div class="credential-grid">
        {publicCredentials.map((credential) => (
          <article class="credential-card">
            <a
              href={credential.image}
              data-lightbox="certificates"
              data-caption={`${credential.title[locale]} · ${credential.issuer} · ${credential.date}`}
              data-alt={credential.title[locale]}
              aria-label={`${copy.certificate}: ${credential.title[locale]}`}
            >
              <img
                src={credential.image}
                width="800"
                height="600"
                loading="lazy"
                alt={credential.title[locale]}
              />
            </a>
            <div class="card-content">
              <h3>{credential.title[locale]}</h3>
              <p>{credential.issuer}</p>
              <time datetime={credential.date}>{credential.date}</time>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
