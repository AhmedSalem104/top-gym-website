---
import { business, type Locale } from '../config/business';
import { t } from '../i18n';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<section id="location" class="section">
  <div class="container">
    <SectionHeading eyebrow={copy.locationLabel} title={copy.locationTitle} />
    <div class="location-grid">
      <div class="panel location-panel">
        <Icon name="pin" size={36} />
        <h3>{copy.locationCard}</h3>
        <p>{copy.locationText}</p>
        {business.location.address && <address>{business.location.address[locale]}</address>}
        <a
          class="button button-gold"
          href={business.links.maps}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.directions}
          <Icon name="arrow" />
        </a>
        <small>{copy.mapNote}</small>
      </div>
      <figure class="location-photo">
        <Photo id="chest-press" locale={locale} />
        <figcaption>{copy.realGym}</figcaption>
      </figure>
    </div>
  </div>
</section>
<section id="contact" class="section surface">
  <div class="container">
    <SectionHeading
      eyebrow={copy.contactLabel}
      title={copy.contactTitle}
      description={copy.contactText}
    />
    <div class="contact-grid">
      <div class="phone-list">
        {business.contacts.map((contact) => (
          <a class="phone-card" href={`tel:${contact.phone}`}>
            <span class="contact-icon">
              <Icon name="phone" size={24} />
            </span>
            <span>
              <span class="eyebrow">
                {copy.call} {contact.name[locale]}
              </span>
              <strong dir="ltr">{contact.display}</strong>
            </span>
            <Icon name="arrow" />
          </a>
        ))}
      </div>
      <div class="panel group-panel">
        <span class="eyebrow">{copy.groupNote}</span>
        <h3 dir="ltr">{business.whatsappGroupName}</h3>
        <p>{copy.groupText}</p>
        <a
          class="button button-gold"
          href={business.links.whatsappGroup}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="chat" />
          {copy.group}
        </a>
        <a
          class="text-link"
          href={business.links.facebook}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.facebook}
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </div>
</section>
<section class="section final-cta">
  <div class="container">
    <p class="eyebrow">{copy.finalLabel}</p>
    <h2>
      {copy.finalLine}
      <br />
      <em>{copy.finalGold}</em>
    </h2>
    <p>{copy.finalText}</p>
    <div class="actions">
      <a class="button button-gold" href={`tel:${business.contacts[0].phone}`}>
        <Icon name="phone" />
        {copy.callAhmed}
      </a>
      <a
        class="button button-dark"
        href={business.links.whatsappGroup}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="chat" />
        {copy.group}
      </a>
    </div>
  </div>
</section>
