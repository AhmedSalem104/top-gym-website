---
import { business, type Locale } from '../config/business';
import { t } from '../i18n';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<section id="location" class="section">
  <div class="container">
    <SectionHeading eyebrow={copy.locationLabel} title={copy.locationTitle} />
    <div class="location-grid" data-motion-group data-motion-step="2">
      <div class="panel location-panel" data-motion="reveal">
        <Icon name="pin" size={36} />
        <h3>{copy.locationCard}</h3>
        <p>{copy.locationText}</p>
        {business.location.address && <address>{business.location.address[locale]}</address>}
        <a
          class="button button-gold"
          href={business.links.maps}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.directions}
          <Icon name="arrow" />
        </a>
        <small>{copy.mapNote}</small>
      </div>
      <figure class="location-photo" data-motion="image">
        <Photo id="chest-press" locale={locale} />
        <figcaption>{copy.realGym}</figcaption>
      </figure>
    </div>
  </div>
</section>
<section id="contact" class="section surface">
  <div class="container">
    <SectionHeading
      eyebrow={copy.contactLabel}
      title={copy.contactTitle}
      description={copy.contactText}
    />
    <div class="contact-grid" data-motion-group data-motion-step="2">
      <div class="phone-list" data-motion-group>
        {business.contacts.map((contact) => (
          <a data-motion="reveal" class="phone-card" href={`tel:${contact.phone}`}>
            <span class="contact-icon">
              <Icon name="phone" size={24} />
            </span>
            <span>
              <span class="eyebrow">
                {copy.call} {contact.name[locale]}
              </span>
              <strong dir="ltr">{contact.display}</strong>
            </span>
            <Icon name="arrow" />
          </a>
        ))}
      </div>
      <div class="panel group-panel" data-motion-group>
        <span class="eyebrow" data-motion="heading">
          {copy.groupNote}
        </span>
        <h3 data-motion="heading" dir="ltr">
          {business.whatsappGroupName}
        </h3>
        <p data-motion="reveal">{copy.groupText}</p>
        <a
          class="button button-gold"
          href={business.links.whatsappGroup}
          data-motion="reveal"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="chat" />
          {copy.group}
        </a>
        <a
          class="text-link"
          href={business.links.facebook}
          data-motion="reveal"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.facebook}
          <Icon name="arrow" />
        </a>
        <figure class="qr-card" data-motion="image">
          <a
            href={business.links.whatsappGroup}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.group}
            data-qr-link
          >
            <img src="/qr/whatsapp.png" alt={copy.qrAlt} width="216" height="216" loading="lazy" />
          </a>
          <figcaption>
            <strong>{copy.qrTitle}</strong>
            <p>{copy.qrText}</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
<section class="section final-cta" data-motion-group>
  <div class="container">
    <p class="eyebrow" data-motion="heading">
      {copy.finalLabel}
    </p>
    <h2 data-motion="heading">
      {copy.finalLine}
      <br />
      <em>{copy.finalGold}</em>
    </h2>
    <p data-motion="reveal">{copy.finalText}</p>
    <div class="actions" data-motion="reveal">
      <a class="button button-gold" href={`tel:${business.contacts[0].phone}`}>
        <Icon name="phone" />
        {copy.callAhmed}
      </a>
      <a
        class="button button-dark"
        href={business.links.whatsappGroup}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="chat" />
        {copy.group}
      </a>
    </div>
  </div>
</section>
