---
import { business, type Locale } from '../config/business';
import { t } from '../i18n';
import Icon from '../components/Icon.astro';
import '../styles/hero.css';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const sizes = '(max-width: 767px) calc(100vw - 40px), (max-width: 1440px) 49vw, 700px';
---

<section class="hero" aria-labelledby="hero-title" data-header-boundary>
  <div class="container hero-layout">
    <div class="hero-content" data-motion-group>
      <p class="hero-label" data-motion="heading">
        <bdi>{business.name}</bdi>
      </p>
      <h1 id="hero-title" data-motion="hero">
        <span>{copy.heroLine}</span> <em>{copy.heroGold}</em>
      </h1>
      <div class="hero-description" data-motion="reveal">
        <ul class="hero-services" role="list">
          {business.hero.services.map((service) => (
            <li>
              <span class="hero-service-icon" aria-hidden="true">
                {service.icon}
              </span>
              <span>{service.text[locale]}</span>
            </li>
          ))}
        </ul>
        <p class="hero-invitation">
          <span aria-hidden="true">📍</span>
          <span>{copy.heroText}</span>
        </p>
      </div>
      <div class="actions">
        <a class="button button-gold" href="#memberships" data-motion="reveal">
          {copy.heroMemberships}
          <Icon name="arrow" />
        </a>
        <a
          class="button button-dark"
          href={business.links.maps}
          target="_blank"
          rel="noopener noreferrer"
          data-motion="reveal"
        >
          <Icon name="pin" />
          {copy.directions}
        </a>
        <a class="text-link" href="#gallery" data-motion="reveal">
          {copy.heroGallery}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <figure class="hero-visual">
      <picture class="hero-image hero-promotional" data-motion="hero-image">
        <source
          type="image/avif"
          srcset="/media/promotional-gym-480.avif 480w, /media/promotional-gym-800.avif 800w, /media/promotional-gym-1200.avif 1200w, /media/promotional-gym-1600.avif 1600w"
          sizes={sizes}
        />
        <img
          src="/media/promotional-gym-1200.webp"
          srcset="/media/promotional-gym-480.webp 480w, /media/promotional-gym-800.webp 800w, /media/promotional-gym-1200.webp 1200w, /media/promotional-gym-1600.webp 1600w"
          sizes={sizes}
          width="4000"
          height="2997"
          alt={copy.promotionalHeroAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>
  </div>
  <div class="container hero-rail" data-motion="reveal">
    {business.facilities.map((facility) => (
      <a href="#facilities">{facility.title[locale]}</a>
    ))}
  </div>
</section>
