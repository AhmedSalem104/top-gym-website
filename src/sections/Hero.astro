---
import { business, type Locale } from '../config/business';
import { t } from '../i18n';
import Icon from '../components/Icon.astro';
import '../styles/hero.css';
import { motion } from '../config/motion';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const cinematicVariables = Object.entries(motion.cinematic)
  .flatMap(([key, value]) =>
    typeof value === 'object'
      ? Object.entries(value).map(([name, token]) => `--hero-${key}-${name}:${token}`)
      : [`--hero-${key}:${typeof value === 'number' ? `${value}ms` : value}`],
  )
  .join(';');
---

<section class="hero" aria-labelledby="hero-title" data-header-boundary style={cinematicVariables}>
  <div class="container hero-layout">
    <div class="hero-content" data-motion-group>
      <p class="hero-label" data-motion="heading">
        <bdi>{business.name}</bdi>
      </p>
      <h1 id="hero-title" data-motion="hero">
        <span>{copy.heroLine}</span> <em>{copy.heroGold}</em>
      </h1>
      <p class="hero-description" data-motion="reveal">
        {copy.heroText}
      </p>
      <div class="actions">
        <a class="button button-gold" href="#memberships" data-motion="reveal">
          {copy.heroMemberships}
          <Icon name="arrow" />
        </a>
        <a
          class="button button-dark"
          href={business.links.maps}
          target="_blank"
          rel="noopener noreferrer"
          data-motion="reveal"
        >
          <Icon name="pin" />
          {copy.directions}
        </a>
        <a class="text-link" href="#gallery" data-motion="reveal">
          {copy.heroGallery}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
  <figure class="hero-visual">
    <div class="hero-camera">
      <picture class="hero-image hero-promotional">
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset="/media/top-gym-hero-mobile-360.avif 360w, /media/top-gym-hero-mobile-704.avif 704w"
          sizes="(max-width: 479px) 480px, 100vw"
        />
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset="/media/top-gym-hero-mobile-360.webp 360w, /media/top-gym-hero-mobile-704.webp 704w"
          sizes="(max-width: 479px) 480px, 100vw"
        />
        <source
          type="image/avif"
          srcset="/media/top-gym-hero-wide-768.avif 768w, /media/top-gym-hero-wide-1200.avif 1200w, /media/top-gym-hero-wide-1672.avif 1672w"
          sizes="100vw"
        />
        <img
          src="/media/top-gym-hero-wide-1672.webp"
          srcset="/media/top-gym-hero-wide-768.webp 768w, /media/top-gym-hero-wide-1200.webp 1200w, /media/top-gym-hero-wide-1672.webp 1672w"
          sizes="100vw"
          width="1672"
          height="940"
          alt={copy.promotionalHeroAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </figure>
  <div class="container hero-rail" data-motion="reveal">
    {business.facilities.map((facility) => (
      <a href="#facilities">{facility.title[locale]}</a>
    ))}
  </div>
</section>
