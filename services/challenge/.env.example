# Local values only. Never copy test credentials into staging/production.
NODE_ENV=development
CHALLENGE_HOST=127.0.0.1
CHALLENGE_PORT=4400
CHALLENGE_DB=.local/challenge.sqlite
CHALLENGE_ORIGIN=http://127.0.0.1:4321
CHALLENGE_ENABLED=false
# Generate independent random 32-byte hex keys in a private secret manager.
CHALLENGE_DATA_KEY=
CHALLENGE_HASH_KEY=
CHALLENGE_GATEWAY_KEY=
# Real operations require an explicitly approved policy file and reviewed bank.
CHALLENGE_POLICY_FILE=
CHALLENGE_BANK_FILE=../../content/challenge/questions.json
CHALLENGE_ALLOW_DRAFT_BANK=false
OTP_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
CHALLENGE_ADMIN_EMAIL=
CHALLENGE_CUSTOMER_EMAIL_ENABLED=false
# Bootstrap only: supply securely, then remove these variables.
CHALLENGE_BOOTSTRAP_EMAIL=
CHALLENGE_BOOTSTRAP_PASSWORD=
CHALLENGE_BOOTSTRAP_TOTP=
