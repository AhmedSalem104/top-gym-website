{
  "name": "@top-gym/challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bank:check": "node src/bank-check.ts",
    "admin:create": "node --env-file-if-exists=.env dist/admin-create.js",
    "backup": "node --env-file-if-exists=.env dist/backup.js"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
