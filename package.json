{
  "name": "top-gym-website",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch": "11.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:serve": "node scripts/test-server.mjs",
    "preview:email": "node scripts/preview-feedback-email.ts",
    "challenge:install": "npm ci --prefix services/challenge",
    "challenge:build": "npm run build --prefix services/challenge",
    "challenge:check": "npm run check --prefix services/challenge",
    "challenge:test": "npm run build --prefix services/challenge && npm test --prefix services/challenge",
    "challenge:bank": "node scripts/compile-challenge-bank.mjs && npm run bank:check --prefix services/challenge -- --draft",
    "challenge:preview:build": "node scripts/build-challenge-preview.mjs",
    "challenge:preview": "node scripts/challenge-test-server.mjs",
    "challenge:email": "node scripts/preview-challenge-email.ts",
    "challenge:e2e": "playwright test -c playwright.challenge.config.ts",
    "test:seo": "node scripts/check-seo.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:seo && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/chivo": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.3.8",
    "nodemailer": "10.3.1",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "1.7.0",
    "jsqr": "1.4.0",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
