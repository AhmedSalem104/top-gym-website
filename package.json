{
  "name": "top-gym-website",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch": "11.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:seo": "node scripts/check-seo.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:seo && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/chivo": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.3.8",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "1.7.0",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
